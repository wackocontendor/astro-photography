const getPhotoTitle = (filename: string) => filename.replace(".JPG", "").replace("_", " ");
const isInitiallyVisible = (index: number) => index === 0 || index === 1 || index === photos.length - 1;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>louisandalens</title>
	</head>
	<body>
		<main>
			<header class="intro">
				<h1>Louis and a lens</h1>
			</header>

			<section class="carousel" aria-label="Photo carousel">
				<button class="carousel-button previous" type="button" aria-label="Previous photo">
					<span aria-hidden="true">&larr;</span>
				</button>
				<div class="carousel-track">
					{photos.map((photo, index) => (
						<div
							class:list={["carousel-slide", { active: index === 0 }]}
							data-index={index}
						>
							<img
								src={`/images/${photo.file}`}
								alt={getPhotoTitle(photo.file)}
								loading={isInitiallyVisible(index) ? "eager" : "lazy"}
							/>
							<span class="photo-details">
								{photo.focalLength} · {photo.aperture} · {photo.shutter}
							</span>
							<span class="photo-date">{photo.date}</span>
						</div>
					))}
				</div>
				<button class="carousel-button next" type="button" aria-label="Next photo">
					<span aria-hidden="true">&rarr;</span>
				</button>
				<p class="carousel-counter" aria-live="polite">1 / {photos.length}</p>
			</section>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		overflow: hidden;
		background: #ddd9d2;
		color: #24221e;
		font-family: Georgia, "Times New Roman", serif;
	}

	main {
		width: min(1400px, calc(100% - 3rem));
		height: 100dvh;
		margin: 0 auto;
		padding: 2rem 0;
	}

	.intro {
		margin-bottom: 1.5rem;
		text-align: center;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 6vw, 4.5rem);
		font-weight: 400;
		letter-spacing: -0.05em;
		line-height: 0.95;
	}

	.carousel {
		position: relative;
		height: calc(100% - 5rem);
		overflow: clip;
	}

	.carousel-track {
		--carousel-gap: 0.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		height: calc(100% - 2.5rem);
		overflow: hidden;
	}

	.carousel-slide {
		position: absolute;
		width: min(62vw, 42rem);
		opacity: 0;
		pointer-events: none;
		transform: translateX(100%) scale(0.82);
		transition: opacity 300ms ease, transform 300ms ease;
	}

	.carousel-slide.active,
	.carousel-slide.previous,
	.carousel-slide.next {
		pointer-events: auto;
	}

	.carousel-slide.active {
		z-index: 2;
		opacity: 1;
		transform: translateX(0) scale(1);
	}

	.carousel-slide.previous {
		z-index: 1;
		opacity: 0.28;
		transform: translateX(calc(-100% - var(--carousel-gap)));
	}

	.carousel-slide.next {
		z-index: 1;
		opacity: 0.28;
		transform: translateX(calc(100% + var(--carousel-gap)));
	}

	.carousel-slide img {
		display: block;
		width: 100%;
		height: min(45vw, 30rem, calc(100dvh - 13rem));
		aspect-ratio: 4 / 3;
		object-fit: cover;
		image-orientation: from-image;
	}

	.carousel-slide.active img {
		object-fit: contain;
	}

	@media (max-width: 600px) {
		.carousel-slide img {
			opacity: 0;
			transition: opacity 180ms ease;
		}

		.carousel-slide img.is-loaded {
			opacity: 1;
		}
	}

	.photo-details {
		display: block;
		margin-top: 0.75rem;
		color: #5d574d;
		font-family: Arial, sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-align: center;
		text-transform: uppercase;
	}

	.photo-date {
		display: block;
		margin-top: 0.35rem;
		color: #6f5a3f;
		font-family: Arial, sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-align: center;
		text-transform: uppercase;
	}

	.carousel-button {
		position: absolute;
		top: 50%;
		z-index: 3;
		display: grid;
		width: 3rem;
		height: 3rem;
		padding: 0;
		border: 1px solid rgb(36 34 30 / 35%);
		border-radius: 50%;
		background: rgb(216 208 192 / 85%);
		color: #24221e;
		cursor: pointer;
		font-size: 1.5rem;
		place-items: center;
		transform: translateY(-50%);
	}

	.carousel-button span {
		display: block;
		line-height: 1;
		transform: translateY(-0.08em);
	}

	.carousel-button:hover,
	.carousel-button:focus-visible {
		background: #f0e9dc;
	}

	.carousel-button.previous {
		left: 1rem;
	}

	.carousel-button.next {
		right: 1rem;
	}

	.carousel-counter {
		margin: 1.5rem 0 0;
		color: #5d574d;
		font-family: Arial, sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.15em;
		text-align: center;
		text-transform: uppercase;
	}

	@media (max-width: 600px) {
		main {
			width: min(100% - 1.5rem, 1400px);
			height: 100dvh;
			padding: 3rem 0 2rem;
		}

		.intro {
			margin-bottom: 2.5rem;
		}

		.carousel {
			display: flex;
			flex-direction: column;
			justify-content: center;
			height: calc(100% - 5.5rem);
			min-height: 0;
		}

		.carousel-track {
			display: flex;
			align-items: flex-start;
			justify-content: center;
			height: fit-content;
			min-height: 0 !important;
			overflow: visible;
			flex: 0 0 auto;
		}

		.carousel-slide {
			display: none;
			position: relative;
			width: 100%;
		}

		.carousel-slide.active {
			display: block;
			opacity: 1;
			transform: none;
		}

		.carousel-slide img {
			height: auto;
			max-width: 100%;
			max-height: calc(100dvh - 16rem);
			aspect-ratio: auto;
			object-fit: contain;
			margin: 0 auto;
		}

		.carousel-button {
			display: none;
		}

		.carousel-counter {
			margin-bottom: 0;
		}

	}
</style>

<script>
	const slides = [...document.querySelectorAll<HTMLElement>(".carousel-slide")];
	const carousel = document.querySelector<HTMLElement>(".carousel");
	const previousButton = document.querySelector<HTMLButtonElement>(".carousel-button.previous");
	const nextButton = document.querySelector<HTMLButtonElement>(".carousel-button.next");
	const counter = document.querySelector<HTMLElement>(".carousel-counter");
	let activeIndex = 0;
	let touchStartX: number | null = null;

	const revealImage = (image: HTMLImageElement) => {
		if (image.complete && image.naturalWidth > 0) {
			image.classList.add("is-loaded");
			return;
		}

		image.addEventListener("load", () => image.classList.add("is-loaded"), { once: true });
	};

	const preloadImage = (index: number) => {
		const image = slides[index]?.querySelector<HTMLImageElement>("img");
		if (!image) return;

		image.loading = "eager";
		revealImage(image);
	};

	const updateCarousel = (nextIndex: number) => {
		activeIndex = (nextIndex + slides.length) % slides.length;

		slides.forEach((slide, index) => {
			slide.classList.toggle("active", index === activeIndex);
			slide.classList.toggle(
				"previous",
				index === (activeIndex - 1 + slides.length) % slides.length,
			);
			slide.classList.toggle("next", index === (activeIndex + 1) % slides.length);
			slide.setAttribute("aria-hidden", index === activeIndex ? "false" : "true");
			slide.tabIndex = index === activeIndex ? 0 : -1;
		});

		if (counter) {
			counter.textContent = `${activeIndex + 1} / ${slides.length}`;
		}

		const activeImage = slides[activeIndex]?.querySelector<HTMLImageElement>("img");
		if (activeImage) revealImage(activeImage);
		preloadImage((activeIndex + 1) % slides.length);
		preloadImage((activeIndex - 1 + slides.length) % slides.length);
	};

	previousButton?.addEventListener("click", () => updateCarousel(activeIndex - 1));
	nextButton?.addEventListener("click", () => updateCarousel(activeIndex + 1));

	carousel?.addEventListener(
		"touchstart",
		(event) => {
			touchStartX = event.touches[0]?.clientX ?? null;
		},
		{ passive: true },
	);

	carousel?.addEventListener(
		"touchend",
		(event) => {
			if (touchStartX === null) return;

			const touchEndX = event.changedTouches[0]?.clientX;
			const swipeDistance = touchEndX === undefined ? 0 : touchEndX - touchStartX;
			touchStartX = null;

			if (Math.abs(swipeDistance) < 50) return;
			updateCarousel(swipeDistance > 0 ? activeIndex - 1 : activeIndex + 1);
		},
		{ passive: true },
	);

	document.addEventListener("keydown", (event) => {
		if (event.key === "ArrowLeft") updateCarousel(activeIndex - 1);
		if (event.key === "ArrowRight") updateCarousel(activeIndex + 1);
	});

	updateCarousel(0);
</script>
