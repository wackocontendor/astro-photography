const getPhotoTitle = (filename: string) => filename.replace(".JPG", "").replace("_", " ");
const isInitiallyVisible = (index: number) => index === 0 || index === 1 || index === photos.length - 1;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Louis and a lens — photographs from an Olympus E-M5." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>louisandalens</title>
	</head>
	<body>
		<main>
			<header class="intro">
				<h1>Louis and a lens</h1>
			</header>

			<section class="carousel" aria-label="Photo carousel">
				<button class="carousel-button previous" type="button" aria-label="Previous photo">
					<span aria-hidden="true">&larr;</span>
				</button>
				<div class="carousel-track">
					{photos.map((photo, index) => (
						<div
							class:list={["carousel-slide", { active: index === 0 }]}
							data-index={index}
						>
							<a
								class="image-link"
								href={`/images/${photo.file}`}
								target="_blank"
								aria-label={`Open ${getPhotoTitle(photo.file)} full size`}
							>
								<Image
									src={`/images/${photo.file}`}
									alt={getPhotoTitle(photo.file)}
									width={1200}
									height={800}
									loading={isInitiallyVisible(index) ? "eager" : "lazy"}
								/>
							</a>
							<span class="photo-details">
								{photo.focalLength} · {photo.aperture} · {photo.shutter}
							</span>
							<span class="photo-date">{photo.date}</span>
						</div>
					))}
				</div>
				<button class="carousel-button next" type="button" aria-label="Next photo">
					<span aria-hidden="true">&rarr;</span>
				</button>
				<p class="carousel-counter" aria-live="polite">1 / {photos.length}</p>
			</section>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		overflow-x: hidden;
		background: #ddd9d2;
		color: #24221e;
		font-family: Georgia, "Times New Roman", serif;
	}

	main {
		width: min(1400px, calc(100% - 3rem));
		margin: 0 auto;
		padding: 6rem 0 4rem;
	}

	.intro {
		margin-bottom: 4rem;
		text-align: center;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 6vw, 4.5rem);
		font-weight: 400;
		letter-spacing: -0.05em;
		line-height: 0.95;
	}

	.carousel {
		position: relative;
		overflow: clip;
	}

	.carousel-track {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: min(65vw, 42rem);
		overflow: hidden;
	}

	.carousel-slide {
		position: absolute;
		width: min(68vw, 48rem);
		opacity: 0;
		pointer-events: none;
		transform: translateX(100%) scale(0.82);
		transition: opacity 300ms ease, transform 300ms ease;
	}

	.carousel-slide.active,
	.carousel-slide.previous,
	.carousel-slide.next {
		pointer-events: auto;
	}

	.carousel-slide.active {
		z-index: 2;
		opacity: 1;
		transform: translateX(0) scale(1);
	}

	.carousel-slide.previous {
		z-index: 1;
		opacity: 0.28;
		transform: translateX(-82%) scale(0.82);
	}

	.carousel-slide.next {
		z-index: 1;
		opacity: 0.28;
		transform: translateX(82%) scale(0.82);
	}

	.carousel-slide img {
		display: block;
		width: 100%;
		height: min(58vw, 36rem);
		object-fit: contain;
		image-orientation: from-image;
	}

	.carousel-slide.previous img,
	.carousel-slide.next img {
		object-fit: cover;
	}

	.photo-details {
		display: block;
		margin-top: 0.75rem;
		color: #5d574d;
		font-family: Arial, sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-align: center;
		text-transform: uppercase;
	}

	.photo-date {
		display: block;
		margin-top: 0.35rem;
		color: #6f5a3f;
		font-family: Arial, sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-align: center;
		text-transform: uppercase;
	}

	.carousel-button {
		position: absolute;
		top: calc(min(58vw, 36rem) / 2);
		z-index: 3;
		display: grid;
		width: 3rem;
		height: 3rem;
		padding: 0;
		border: 1px solid rgb(36 34 30 / 35%);
		border-radius: 50%;
		background: rgb(216 208 192 / 85%);
		color: #24221e;
		cursor: pointer;
		font-size: 1.5rem;
		place-items: center;
		transform: translateY(-50%);
	}

	.carousel-button:hover,
	.carousel-button:focus-visible {
		background: #f0e9dc;
	}

	.carousel-button.previous {
		left: 1rem;
	}

	.carousel-button.next {
		right: 1rem;
	}

	.carousel-counter {
		margin: 1.5rem 0 0;
		color: #5d574d;
		font-family: Arial, sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.15em;
		text-align: center;
		text-transform: uppercase;
	}

	a {
		display: block;
	}

	a:focus-visible {
		outline: 2px solid #6f5a3f;
		outline-offset: 4px;
	}

	@media (max-width: 600px) {
		main {
			width: min(100% - 1.5rem, 1400px);
			padding-top: 3rem;
		}

		.intro {
			margin-bottom: 2.5rem;
		}

		.carousel-track {
			height: calc(92vw + 3.5rem);
			min-height: 0;
		}

		.carousel-slide {
			width: 88vw;
		}

		.carousel-slide.previous {
			transform: translateX(-76%) scale(0.78);
		}

		.carousel-slide.next {
			transform: translateX(76%) scale(0.78);
		}

		.carousel-slide img {
			height: 92vw;
		}

		.carousel-button {
			width: 2.5rem;
			height: 2.5rem;
			top: 46vw;
		}
	}
</style>

<script>
	const slides = [...document.querySelectorAll<HTMLElement>(".carousel-slide")];
	const previousButton = document.querySelector<HTMLButtonElement>(".carousel-button.previous");
	const nextButton = document.querySelector<HTMLButtonElement>(".carousel-button.next");
	const counter = document.querySelector<HTMLElement>(".carousel-counter");
	let activeIndex = 0;

	const updateCarousel = (nextIndex: number) => {
		activeIndex = (nextIndex + slides.length) % slides.length;

		slides.forEach((slide, index) => {
			slide.classList.toggle("active", index === activeIndex);
			slide.classList.toggle(
				"previous",
				index === (activeIndex - 1 + slides.length) % slides.length,
			);
			slide.classList.toggle("next", index === (activeIndex + 1) % slides.length);
			slide.setAttribute("aria-hidden", index === activeIndex ? "false" : "true");
			slide.tabIndex = index === activeIndex ? 0 : -1;
		});

		if (counter) {
			counter.textContent = `${activeIndex + 1} / ${slides.length}`;
		}
	};

	previousButton?.addEventListener("click", () => updateCarousel(activeIndex - 1));
	nextButton?.addEventListener("click", () => updateCarousel(activeIndex + 1));

	document.addEventListener("keydown", (event) => {
		if (event.key === "ArrowLeft") updateCarousel(activeIndex - 1);
		if (event.key === "ArrowRight") updateCarousel(activeIndex + 1);
	});

	updateCarousel(0);
</script>
